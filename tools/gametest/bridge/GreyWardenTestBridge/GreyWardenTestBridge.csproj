<Project Sdk="Microsoft.NET.Sdk">

  <!-- 游戏测试桥（tools/gametest/PROTOCOL.md）的游戏内一侧。独立测试模组：
       不进 GreyWardenPolicePurity/_Module，不进玩家 ZIP。
       游戏 DLL 引用写法照抄 GreyWardenPolicePurity.csproj（HintPath 指游戏目录）；
       灰袍主 DLL 引用 live 模组里的那一份，所以先构建主项目再构建本项目。 -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <TargetFramework>net472</TargetFramework>
    <Platforms>x64</Platforms>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>GreyWardenTestBridge</AssemblyName>
    <RootNamespace>GreyWardenTestBridge</RootNamespace>
    <GameFolder>D:\steam\steamapps\common\Mount &amp; Blade II Bannerlord</GameFolder>
    <!-- 与主项目同一个开关：开发构建带诊断，主 DLL 才向本程序集开放 internal 成员。 -->
    <GwpDiagnosticsEnabled Condition="'$(GwpDiagnosticsEnabled)' == ''">true</GwpDiagnosticsEnabled>
    <GameBinariesFolder Condition="Exists('$(GameFolder)\bin\Win64_Shipping_Client\Bannerlord.exe')">Win64_Shipping_Client</GameBinariesFolder>
    <GameBinariesFolder Condition="Exists('$(GameFolder)\bin\Gaming.Desktop.x64_Shipping_Client\Bannerlord.exe')">Gaming.Desktop.x64_Shipping_Client</GameBinariesFolder>
    <BridgeModuleFolder>$(GameFolder)\Modules\GreyWardenTestBridge</BridgeModuleFolder>
    <OutputPath>$(BridgeModuleFolder)\bin\$(GameBinariesFolder)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- 中间产物留在 obj\（不改 IntermediateOutputPath）：Python 端按
         tools/gametest/bridge/**/obj/**/GreyWardenTestBridge.dll 找仓库构建，与 live 比哈希。 -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(GwpDiagnosticsEnabled)' == 'true'">
    <DefineConstants>$(DefineConstants);GWP_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(GameFolder)\bin\$(GameBinariesFolder)\Newtonsoft.Json.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\bin\$(GameBinariesFolder)\TaleWorlds.*.dll" Exclude="$(GameFolder)\bin\$(GameBinariesFolder)\TaleWorlds.Native.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\Native\bin\$(GameBinariesFolder)\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\SandBox\bin\$(GameBinariesFolder)\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\SandBoxCore\bin\$(GameBinariesFolder)\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\GreyWarden\bin\$(GameBinariesFolder)\GreyWardenPolicePurity.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nullable" Version="1.3.1" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <!-- 构建后同步模组描述文件到 live 的 Modules\GreyWardenTestBridge\。 -->
  <Target Name="CopyBridgeModuleFiles" AfterTargets="Build">
    <ItemGroup>
      <BridgeModuleFiles Include="$(MSBuildProjectDirectory)\_Module\**" />
    </ItemGroup>
    <Copy SourceFiles="@(BridgeModuleFiles)" DestinationFiles="@(BridgeModuleFiles->'$(BridgeModuleFolder)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />
    <Message Text="GreyWardenTestBridge synced → $(BridgeModuleFolder)\" Importance="high" />
  </Target>

</Project>
