<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Match SubModule.xml for the v1.4-r16.2 release. -->
    <Version>1.4.16.2</Version>
    <TargetFramework>net472</TargetFramework>
    <Platforms>x64</Platforms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <BuildForWindows>false</BuildForWindows>
    <BuildForWindowsStore>false</BuildForWindowsStore>
    <ModuleId>$(MSBuildProjectName)</ModuleId>
    <ModuleName>$(MSBuildProjectName)</ModuleName>
    <ModuleUrl></ModuleUrl>
    <GameFolder>D:\steam\steamapps\common\Mount &amp; Blade II Bannerlord</GameFolder>
    <!-- Ordinary development builds keep AI diagnostics and deploy straight to
         the live test module. Formal player packages override both properties
         so their DLL is produced separately and cannot write test logs. -->
    <GwpDiagnosticsEnabled Condition="'$(GwpDiagnosticsEnabled)' == ''">true</GwpDiagnosticsEnabled>
    <DeployToLiveModule Condition="'$(DeployToLiveModule)' == ''">true</DeployToLiveModule>
    <GameBinariesFolder Condition="Exists('$(GameFolder)\bin\Win64_Shipping_Client\Bannerlord.exe')">Win64_Shipping_Client</GameBinariesFolder>
    <GameBinariesFolder Condition="Exists('$(GameFolder)\bin\Gaming.Desktop.x64_Shipping_Client\Bannerlord.exe')">Gaming.Desktop.x64_Shipping_Client</GameBinariesFolder>
    <!-- A non-deploying build must isolate the DLL as well as module data.
         An explicit command-line OutputPath still takes precedence. -->
    <OutputPath Condition="'$(DeployToLiveModule)' == 'true'">$(GameFolder)\Modules\GreyWarden\bin\$(GameBinariesFolder)\</OutputPath>
    <OutputPath Condition="'$(DeployToLiveModule)' != 'true'">$(MSBuildProjectDirectory)\bin\$(Configuration)\isolated\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GwpDiagnosticsEnabled)' == 'true'">
    <DefineConstants>$(DefineConstants);GWP_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>
  <Target Name="VerifyPlayerTextSources" BeforeTargets="BeforeBuild">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)\..\tools\Generate-PlayerText.py&quot; --check" />
  </Target>

  <!-- Compile the game API used by the referenced installation. 1.5 changed
       passive attack damage, and 1.5.7 uses the newer campaign model APIs. -->
  <Target Name="GwpDetectTargetGame" BeforeTargets="CoreCompile">
    <XmlPeek XmlInputPath="$(GameFolder)\Modules\Native\SubModule.xml"
             Query="/Module/Version/@value"
             Condition="'$(GwpTargetGame)' == ''">
      <Output TaskParameter="Result" PropertyName="GwpNativeVersion" />
    </XmlPeek>
    <PropertyGroup Condition="'$(GwpTargetGame)' == ''">
      <GwpVersionNumber>$(GwpNativeVersion.TrimStart('vV'))</GwpVersionNumber>
      <GwpTargetGame>148</GwpTargetGame>
      <GwpTargetGame Condition="$([System.Version]::Parse('$(GwpVersionNumber)').CompareTo($([System.Version]::Parse('1.5')))) &gt;= 0">150</GwpTargetGame>
      <GwpTargetGame Condition="$([System.Version]::Parse('$(GwpVersionNumber)').CompareTo($([System.Version]::Parse('1.5.7')))) &gt;= 0">157</GwpTargetGame>
    </PropertyGroup>
    <PropertyGroup>
      <DefineConstants Condition="'$(GwpTargetGame)' == '150' Or '$(GwpTargetGame)' == '157'">$(DefineConstants);GWP_GAME_150_OR_LATER</DefineConstants>
      <DefineConstants Condition="'$(GwpTargetGame)' == '157'">$(DefineConstants);GWP_GAME_157_OR_LATER</DefineConstants>
    </PropertyGroup>
    <Message Importance="high" Condition="'$(GwpNativeVersion)' != ''"
             Text="GreyWarden: installed game $(GwpNativeVersion) -> GwpTargetGame=$(GwpTargetGame)" />
  </Target>

  <PropertyGroup Condition="$(TargetFramework) == 'net472'">
    <BuildForWindows>true</BuildForWindows>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(GameFolder)\bin\$(GameBinariesFolder)\Newtonsoft.Json.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\bin\$(GameBinariesFolder)\TaleWorlds.*.dll" Exclude="$(GameFolder)\bin\$(GameBinariesFolder)\TaleWorlds.Native.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\Native\bin\$(GameBinariesFolder)\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\SandBox\bin\$(GameBinariesFolder)\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\SandBoxCore\bin\$(GameBinariesFolder)\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\StoryMode\bin\$(GameBinariesFolder)\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\CustomBattle\bin\$(GameBinariesFolder)\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\BirthAndDeath\bin\$(GameBinariesFolder)\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Use the official self-contained net472 Harmony runtime. It retains the
         2.4.2 assembly identity used by current community modules without
         relying on their separately loaded MonoMod dependencies. -->
    <Reference Include="0Harmony">
      <HintPath>lib\0Harmony.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <PackageReference Include="Nullable" Version="1.3.1" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="IsExternalInit" Version="1.0.3" PrivateAssets="all" IncludeAssets ="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>


  <Target Name="RequireLiveDiagnostics" BeforeTargets="PrepareForBuild" Condition="'$(DeployToLiveModule)' == 'true'">
    <Error Condition="'$(GwpDiagnosticsEnabled)' != 'true'" Text="The live development module requires diagnostics. Build player binaries with DeployToLiveModule=false." />
  </Target>

  <!-- 每次 build 后同步开发版运行时文件；玩家打包美术不进入 live。 -->
  <Target Name="CopyModuleData" AfterTargets="Build" Condition="'$(DeployToLiveModule)' == 'true'">
    <ItemGroup>
      <!-- Preserve the live editable Assets, AssetSources and RuntimeDataCache.
           Ordinary builds must neither overwrite them nor copy the player-only
           AssetPackages or dedicated-server DsAssetPackages into development live. -->
      <!-- Release ZIPs are created only by the formal GitHub release workflow
           and live beside the GreyWarden directory in the game's Modules
           folder. A normal build must never copy an archive into the module. -->
      <ModuleFiles Include="$(MSBuildProjectDirectory)\_Module\**"
                   Exclude="$(MSBuildProjectDirectory)\_Module\Assets\**;$(MSBuildProjectDirectory)\_Module\AssetSources\**;$(MSBuildProjectDirectory)\_Module\RuntimeDataCache\**;$(MSBuildProjectDirectory)\_Module\AssetPackages\**;$(MSBuildProjectDirectory)\_Module\DsAssetPackages\**;$(MSBuildProjectDirectory)\_Module\*.zip;$(MSBuildProjectDirectory)\_Module\*.zip.sha256;$(MSBuildProjectDirectory)\_Module\**\*.zip;$(MSBuildProjectDirectory)\_Module\**\*.zip.sha256" />
    </ItemGroup>
    <Copy SourceFiles="@(ModuleFiles)" DestinationFiles="@(ModuleFiles->'$(GameFolder)\Modules\GreyWarden\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />
    <Message Text="ModuleData synced → $(GameFolder)\Modules\GreyWarden\" Importance="high" />
  </Target>

  <!-- The Modding Kit runs a different executable and only probes the
       module's Win64_Shipping_wEditor directory. Keep the module assembly and
       its Harmony runtime dependency in that directory after every build. -->
  <Target Name="CopyEditorBinaries" AfterTargets="Build" Condition="'$(DeployToLiveModule)' == 'true'">
    <PropertyGroup>
      <EditorModuleBin>$(GameFolder)\Modules\GreyWarden\bin\Win64_Shipping_wEditor\</EditorModuleBin>
    </PropertyGroup>
    <ItemGroup>
      <EditorBinaries Include="$(TargetPath)" />
      <EditorBinaries Include="$(TargetDir)$(AssemblyName).pdb" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
      <EditorBinaries Include="$(TargetDir)0Harmony.dll" Condition="Exists('$(TargetDir)0Harmony.dll')" />
    </ItemGroup>
    <MakeDir Directories="$(EditorModuleBin)" />
    <Copy SourceFiles="@(EditorBinaries)" DestinationFolder="$(EditorModuleBin)" SkipUnchangedFiles="false" />
    <Message Text="Editor binaries synced → $(EditorModuleBin)" Importance="high" />
  </Target>

</Project>
