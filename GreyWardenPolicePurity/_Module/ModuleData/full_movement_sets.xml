<?xml version="1.0" encoding="utf-8"?>
<full_movement_sets>
  <!--
    Every full movement set the engine can put an agent into has to answer for
    all six movement modes.  Of the 25 native sets, 22 declare swimming and
    diving outright and the remaining three - the "_with_shield" variants -
    inherit them through base_set.  There is no weapon-specific swim
    animation anywhere: all 22 point at swim_unarmed and dive_unarmed.

    This set used to declare only the four land modes and had no base_set,
    which made it the one reachable set in the game with no swimming or diving
    entry.  It is only active while both blades are drawn, because the usage
    sets ask for it with require_left_hand_usage_root_set="dual_shield", so a
    dual wielder entering water was the only way to ask the engine for a
    movement set that did not exist - which is what crashed the game.  A
    single blade falls back to onehanded_swing_cantblock and a sheathed pair
    to no_weapon, and both of those answer for water, which is why only the
    drawn pair ever crashed and why land combat never did.

    base_set matches how native builds onehanded_swing_cantblock_with_shield;
    the explicit swimming and diving entries match the other 22 sets.  Both
    are declared so the lookup resolves regardless of which path the engine
    takes.
  -->
  <full_movement_set id="1h_with_dual_shield" base_set="onehanded_swing_cantblock">
    <movement_set id="walk_1h_with_dual_shield" left_stance="False" movement_mode="walking" />
    <movement_set id="run_1h_with_dual_shield" left_stance="False" movement_mode="running" />
    <movement_set id="crouch_walk_1h_with_dual_shield" left_stance="False" movement_mode="crouch_walking" />
    <movement_set id="crouch_run_1h_with_dual_shield" left_stance="False" movement_mode="crouch_running" />
    <movement_set id="walk_1h_with_dual_shield_left_stance" left_stance="True" movement_mode="walking" />
    <movement_set id="run_1h_with_dual_shield_left_stance" left_stance="True" movement_mode="running" />
    <movement_set id="crouch_walk_1h_with_dual_shield_left_stance" left_stance="True" movement_mode="crouch_walking" />
    <movement_set id="crouch_run_1h_with_dual_shield_left_stance" left_stance="True" movement_mode="crouch_running" />
    <movement_set id="swim_unarmed" left_stance="False" movement_mode="swimming" />
    <movement_set id="dive_unarmed" left_stance="False" movement_mode="diving" />
  </full_movement_set>
</full_movement_sets>
