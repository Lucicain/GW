<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#000000B0" DoNotAcceptEvents="true" />
        <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="920" SuggestedHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="Frame1Brush">
          <Children>
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="55" MarginTop="18" Brush="Encyclopedia.SubPage.Title.Text" Text="@Title" DoNotAcceptEvents="true" />
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="48" MarginTop="72" MarginLeft="55" MarginRight="55" Brush="Encyclopedia.SubPage.SubTitle.Text" Text="@Description" CanBreakWords="true" DoNotAcceptEvents="true" />
            <ListPanel DataSource="{Rows}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom" MarginTop="130" MarginLeft="65" MarginRight="65">
              <ItemTemplate>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="54">
                  <Children>
                    <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="370" Brush="Encyclopedia.SubPage.SubTitle.Text" Brush.TextHorizontalAlignment="Left" Text="@Name" DoNotAcceptEvents="true" />
                    <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="200" MarginLeft="376" Brush="Encyclopedia.SubPage.SubTitle.Text" Brush.TextHorizontalAlignment="Left" Text="@Price" DoNotAcceptEvents="true" />
                    <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Right" VerticalAlignment="Center" StackLayout.LayoutMethod="HorizontalLeftToRight">
                      <Children>
                        <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="38" SuggestedHeight="38" Brush="GameMenu.ManageHideoutTroops.MinusButton" Command.Click="ExecuteRemove" />
                        <IntegerInputTextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="84" SuggestedHeight="38" MarginLeft="6" MarginRight="6" Brush="Barter.AmountInput.Text" Brush.TextHorizontalAlignment="Center" IntText="@Quantity" MinInt="0" MaxInt="@MaxQuantity" EnableClamp="true" MaxLength="3" />
                        <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="38" SuggestedHeight="38" Brush="GameMenu.ManageHideoutTroops.PlusButton" Command.Click="ExecuteAdd" />
                      </Children>
                    </ListPanel>
                  </Children>
                </Widget>
              </ItemTemplate>
            </ListPanel>
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="44" VerticalAlignment="Bottom" MarginBottom="105" MarginLeft="60" MarginRight="60" Brush="Encyclopedia.SubPage.ItemDecription.Text" Text="@Restriction" CanBreakWords="true" DoNotAcceptEvents="true" />
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32" VerticalAlignment="Bottom" MarginBottom="74" MarginLeft="60" MarginRight="60" Brush="Encyclopedia.SubPage.SubTitle.Text" Text="@Summary" DoNotAcceptEvents="true" />
            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="HorizontalSpaced" VerticalAlignment="Bottom" MarginLeft="95" MarginRight="95" MarginBottom="16">
              <Children>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="225" SuggestedHeight="50" Brush="ButtonBrush3" Command.Click="ExecuteCancel" DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                  <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Crafting.History.Control.Button.Text" Text="@CancelText" DoNotAcceptEvents="true" /></Children>
                </ButtonWidget>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="225" SuggestedHeight="50" Brush="ButtonBrush1" Command.Click="ExecuteConfirm" IsEnabled="@CanConfirm" DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                  <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Crafting.History.Control.Button.Text" Text="@ConfirmText" DoNotAcceptEvents="true" /></Children>
                </ButtonWidget>
              </Children>
            </ListPanel>
          </Children>
        </BrushWidget>
      </Children>
    </Widget>
  </Window>
</Prefab>
