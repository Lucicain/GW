                                              <ItemTemplate>
                                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MinHeight="30" MarginBottom="12" Text="@Text" Brush="Encyclopedia.Text" Brush.TextHorizontalAlignment="Left" Brush.FontSize="22" DoNotAcceptEvents="true" CanBreakWords="true" />
