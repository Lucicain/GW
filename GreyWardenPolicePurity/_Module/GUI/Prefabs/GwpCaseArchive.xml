                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="270" SuggestedHeight="54" Brush="ButtonBrush1" Command.Click="ExecuteAccept" UpdateChildrenStates="true" DoNotPassEventsToChildren="true" IsVisible="@ShowAccept" IsEnabled="@CanAccept">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DoNotAcceptEvents="true" Brush="Standard.DialogCloseButtons.ButtonText" Text="@AcceptText" MarginLeft="10" MarginRight="10" CanBreakWords="true" Brush.FontSize="24" />
                      </Children>
                    </ButtonWidget>
                    <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="54" StackLayout.LayoutMethod="HorizontalLeftToRight" MarginTop="8">
                      <Children>
                        <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="210" SuggestedHeight="54" Brush="ButtonBrush2" Command.Click="ExecuteHero" UpdateChildrenStates="true" DoNotPassEventsToChildren="true" IsVisible="@HasHero">
