                                      <ItemTemplate>
                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MinHeight="34" MarginBottom="16" Text="@Text" Brush="Encyclopedia.Text" Brush.TextHorizontalAlignment="Left" Brush.FontSize="22" DoNotAcceptEvents="true" CanBreakWords="true" />
                                      </ItemTemplate>
                                    </ListPanel>
                                    <ListPanel DataSource="{Sections}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
