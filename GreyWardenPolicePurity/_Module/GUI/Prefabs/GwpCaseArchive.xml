                                <ListPanel Id="DetailList" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom" MarginRight="24">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MinHeight="42" Text="@DetailTitle" Brush="Clan.RightPanel.Name.Text" Brush.TextHorizontalAlignment="Left" MarginBottom="12" DoNotAcceptEvents="true" CanBreakWords="true" />
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MinHeight="30" Text="@DetailSummary" Brush="Encyclopedia.Text" Brush.TextHorizontalAlignment="Left" MarginBottom="20" DoNotAcceptEvents="true" CanBreakWords="true" Brush.FontSize="24" />
