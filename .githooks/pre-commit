#!/bin/sh
# Shared by every harness and editor, because git runs it for all of them.
#
# Rebuilds the generated code map and the progress.md roll-ups and stages
# them, then refuses the commit only for mechanical errors nobody keeps on
# purpose: duplicate journal entries (a branch merge appended ten twice on
# 2026-10-07) and code hygiene. Everything else the check reports is for the
# agent to act on, not a gate (user ruling 2026-10-07). A merge runs this too,
# through pre-merge-commit.

set -u

root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0

python=$(command -v python || command -v python3) || {
  echo "pre-commit: python not found; the tidy check cannot run" >&2
  exit 1
}

git diff --cached --quiet && exit 0

map="GreyWardenPolicePurity/docs/state/code-map.md"
progress="GreyWardenPolicePurity/docs/state/progress.md"

# Stage generated progress.md only when it had no unstaged hand edits of its
# own, so a half-written edit is never swept into the commit.
progress_clean=0
git diff --quiet -- "$progress" && progress_clean=1

report=$("$python" tools/Check-StateFreshness.py --strict 2>&1)
rc=$?

if git diff --cached --name-only | grep -qE '^GreyWardenPolicePurity/[^/]+\.cs$' \
   && ! git diff --quiet -- "$map"; then
  git add "$map"
  echo "pre-commit: code-map.md regenerated and staged"
fi
if [ "$progress_clean" = 1 ] && ! git diff --quiet -- "$progress"; then
  git add "$progress"
  echo "pre-commit: progress.md roll-ups regenerated and staged"
fi

if [ "$rc" -ne 0 ]; then
  echo "$report" | sed -n '/\[!\]/,$p' | head -60
  echo "" >&2
  echo "pre-commit: commit refused - duplicate journal entries or code hygiene, see above." >&2
  exit 1
fi

exit 0
