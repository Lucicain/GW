#!/bin/sh
# Keep the generated code map and the state-freshness report honest, whichever
# agent or editor produced the commit.
#
# Claude Code refreshes the map through a PostToolUse hook, but Codex,
# Antigravity and a human in an editor do not fire that hook. Git does. This is
# therefore the only layer where the guarantee actually holds for everyone.
#
# The map and the freshness report never block a commit: they regenerate,
# stage and report. Code hygiene does block (user ruling 2026-10-05): a catch
# with no recorded failure behind it, or a declaration nothing uses, is garbage,
# and refusing it at commit time is the only place that holds for every agent.

set -u

root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0

python=$(command -v python || command -v python3) || {
  echo "pre-commit: python not found, skipping code-map refresh" >&2
  exit 0
}

# The 待实测 roll-up in progress.md is generated from the state headers, so a
# commit that only edits state files must refresh it too. Stage it only when
# progress.md had no unstaged edits of its own, so hand edits are never swept in.
progress="GreyWardenPolicePurity/docs/state/progress.md"
if git diff --cached --name-only --diff-filter=ACMR \
   | grep -qE '^GreyWardenPolicePurity/docs/state/[^/]+\.md$'; then
  if git diff --quiet -- "$progress"; then
    "$python" tools/Check-StateFreshness.py >/dev/null 2>&1
    if ! git diff --quiet -- "$progress"; then
      git add "$progress"
      echo "pre-commit: progress.md 待实测汇总 regenerated and staged"
    fi
  else
    echo "pre-commit: progress.md has unstaged edits; run tools/Check-StateFreshness.py and stage it yourself" >&2
  fi
fi

# Only do the rest when C# actually changed in this commit.
if git diff --cached --name-only --diff-filter=ACMR \
   | grep -qE '^GreyWardenPolicePurity/[^/]+\.cs$'; then

  map="GreyWardenPolicePurity/docs/state/code-map.md"
  "$python" tools/Generate-CodeMap.py >/dev/null 2>&1 || {
    echo "pre-commit: code-map generation failed; committing without refresh" >&2
    exit 0
  }
  if ! git diff --quiet -- "$map"; then
    git add "$map"
    echo "pre-commit: code-map.md regenerated and staged"
  fi

  echo ""
  "$python" tools/Check-StateFreshness.py 2>/dev/null \
    | sed -n '/\[!\]/,$p' | head -40
  echo ""

  if ! "$python" tools/Check-CodeHygiene.py; then
    echo "pre-commit: commit refused - fix the code hygiene findings above." >&2
    exit 1
  fi
fi

exit 0
