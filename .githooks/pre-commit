#!/bin/sh
# Keep the generated code map and the state-freshness report honest, whichever
# agent or editor produced the commit.
#
# Claude Code refreshes the map through a PostToolUse hook, but Codex,
# Antigravity and a human in an editor do not fire that hook. Git does. This is
# therefore the only layer where the guarantee actually holds for everyone.
#
# It never blocks a commit. It regenerates, stages the result, and reports.
# A gate that stops work gets disabled; a report that is always right does not.

set -u

root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0

python=$(command -v python || command -v python3) || {
  echo "pre-commit: python not found, skipping code-map refresh" >&2
  exit 0
}

# Only do the work when C# actually changed in this commit.
if git diff --cached --name-only --diff-filter=ACMR \
   | grep -qE '^GreyWardenPolicePurity/[^/]+\.cs$'; then

  map="GreyWardenPolicePurity/docs/state/code-map.md"
  "$python" tools/Generate-CodeMap.py >/dev/null 2>&1 || {
    echo "pre-commit: code-map generation failed; committing without refresh" >&2
    exit 0
  }
  if ! git diff --quiet -- "$map"; then
    git add "$map"
    echo "pre-commit: code-map.md regenerated and staged"
  fi

  echo ""
  "$python" tools/Check-StateFreshness.py 2>/dev/null \
    | sed -n '/\[!\]/,$p' | head -40
  echo ""
fi

exit 0
