#!/bin/sh
# Every commit, from every agent or editor, has to pass the same tidy check.
#
# Claude Code and Codex also run it at the end of each turn (Stop hooks), but
# Antigravity and a human in an editor do not; git does, for everyone. This is
# the layer where the guarantee actually holds.
#
# What it does: rebuild the generated code map and the progress.md roll-ups,
# stage them, then run tools/Check-StateFreshness.py --strict, which includes
# code hygiene. Anything in its 必须清零 list that is not zero refuses the
# commit (user ruling 2026-10-07: other harnesses must meet the same bar).
# A merge runs this too, through pre-merge-commit.

set -u

root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0

python=$(command -v python || command -v python3) || {
  echo "pre-commit: python not found; the tidy check cannot run" >&2
  exit 1
}

git diff --cached --quiet && exit 0

map="GreyWardenPolicePurity/docs/state/code-map.md"
progress="GreyWardenPolicePurity/docs/state/progress.md"

# Stage generated progress.md only when it had no unstaged hand edits of its
# own, so a half-written edit is never swept into the commit.
progress_clean=0
git diff --quiet -- "$progress" && progress_clean=1

report=$("$python" tools/Check-StateFreshness.py --strict 2>&1)
rc=$?

if git diff --cached --name-only | grep -qE '^GreyWardenPolicePurity/[^/]+\.cs$' \
   && ! git diff --quiet -- "$map"; then
  git add "$map"
  echo "pre-commit: code-map.md regenerated and staged"
fi
if [ "$progress_clean" = 1 ] && ! git diff --quiet -- "$progress"; then
  git add "$progress"
  echo "pre-commit: progress.md roll-ups regenerated and staged"
fi

if [ "$rc" -ne 0 ]; then
  echo "$report" | sed -n '/\[!\]/,$p' | head -60
  echo "" >&2
  echo "pre-commit: commit refused - clear the 必须清零 items above (AGENTS.md 每轮收尾)." >&2
  exit 1
fi

exit 0
